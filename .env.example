# Copy to .env.local for local development (.env* is git-ignored).
#
# Local dev needs NEITHER of these — the app falls back to the SQLite file at
# ./data/triageflow.db. Set them to point at a hosted Turso database instead,
# which is what the deployed app uses.

# Turso: `turso db show triageflow --url` (starts with libsql://)
DATABASE_URL=

# Turso: `turso db tokens create triageflow`
DATABASE_AUTH_TOKEN=
